#!/usr/bin/env bash
set -u

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root" || exit 1

mkdir -p tmp

if ! command -v systemd-run >/dev/null 2>&1; then
  printf 'systemd-run is required for memory-limited Tya execution\n' >&2
  exit 127
fi

timeout_seconds="${TYA_SAFE_TIMEOUT:-20}"
memory_max="${TYA_MEMORY_MAX:-4G}"
memory_swap_max="${TYA_MEMORY_SWAP_MAX:-1G}"
stamp="$(date +%Y%m%d-%H%M%S)-$$"
unit_name="flakewatch-tya-safe-${stamp}.service"
log_path="tmp/tya-safe-${stamp}.log"
status_path="tmp/tya-safe-${stamp}.status"
done_path="tmp/tya-safe-${stamp}.done"

{
  printf 'cwd: %s\n' "$repo_root"
  printf 'timeout: %ss\n' "$timeout_seconds"
  printf 'command:'
  printf ' %q' tya "$@"
  printf '\n\n'
  printf 'isolation: systemd unit=%s, stdin=/dev/null, stdout/stderr=file\n' "$unit_name"
  printf 'memory: max=%s, swap_max=%s\n' "$memory_max" "$memory_swap_max"
  printf '\n'
} >"$log_path"

(
  set +e
  exec </dev/null
  systemd-run --user --wait --pipe --collect --unit="$unit_name" --working-directory="$repo_root" \
    -p "MemoryMax=$memory_max" -p "MemorySwapMax=$memory_swap_max" \
    timeout --kill-after=3s "$timeout_seconds" tya "$@" >>"$log_path" 2>&1
  status=$?

  printf '%s\n' "$status" >"$status_path"

  if [ "$status" -eq 124 ]; then
    printf 'timed out after %ss\n' "$timeout_seconds" >>"$log_path"
  elif [ "$status" -eq 137 ]; then
    printf 'killed after timeout grace period\n' >>"$log_path"
  fi

  printf 'done\n' >"$done_path"
) &
runner_pid=$!

while kill -0 "$runner_pid" 2>/dev/null; do
  sleep 0.2
done

wait "$runner_pid" 2>/dev/null

if [ -f "$status_path" ]; then
  status="$(cat "$status_path")"
else
  status=125
  printf '%s\n' "$status" >"$status_path"
  printf 'runner exited before writing status\n' >>"$log_path"
fi

printf 'status=%s\nlog=%s\nstatus_file=%s\n' "$status" "$log_path" "$status_path"
exit "$status"
