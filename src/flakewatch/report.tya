import file
import json
import template
import flakewatch/view_model/* as *

class Report
  history: nil

  junit: nil

  initialize: ->
    self.history = History()
    self.junit = JUnit()

  apply_items: by_test, items ->
    i = 0
    while i < items.len()
      item = items[i]
      class_name = text(item["classname"])
      if class_name == ""
        class_name = text(item["suite"])
      test_name = text(item["name"])
      key = class_name + "." + test_name
      if by_test[key] == nil
        row =
          name: key
          test_name: test_name
          suite: text(item["suite"])
          file: text(item["file"])
          line: text(item["line"])
          observations: 0
          pass_count: 0
          fail_count: 0
          error_count: 0
          skipped_count: 0
          failure_count: 0
          transition_count: 0
          total_duration: 0.0
          max_duration: 0.0
          run_count: 0
          source_ids: {}
          first_observed_at: ""
          last_observed_at: ""
          last_status: ""
          previous_passish: ""
          recent_passish: []
          sha_stats: {}
        by_test[key] = row
      row = by_test[key]
      item_file = text(item["file"])
      if row["file"] == "" and item_file != ""
        row["file"] = item_file
      if row["line"] == "" and item_file != ""
        row["line"] = text(item["line"])
      status = text(item["status"])
      sha = text(item["sha"])
      if sha != ""
        if row["sha_stats"][sha] == nil
          row["sha_stats"][sha] =
            pass_count: 0
            failure_count: 0
            transition_count: 0
            previous_passish: ""
        sha_stat = row["sha_stats"][sha]
        if status == "passed"
          if (
            sha_stat["previous_passish"] != "" and sha_stat["previous_passish"] != "true"
          )
            sha_stat["transition_count"] = sha_stat["transition_count"] + 1
          sha_stat["previous_passish"] = "true"
          sha_stat["pass_count"] = sha_stat["pass_count"] + 1
        elseif status == "failed" or status == "error"
          if (
            sha_stat["previous_passish"] != "" and sha_stat["previous_passish"] != "false"
          )
            sha_stat["transition_count"] = sha_stat["transition_count"] + 1
          sha_stat["previous_passish"] = "false"
          sha_stat["failure_count"] = sha_stat["failure_count"] + 1
      passish = "false"
      if status == "passed" or status == "skipped"
        passish = "true"
      if row["previous_passish"] != "" and row["previous_passish"] != passish
        row["transition_count"] = row["transition_count"] + 1
      row["previous_passish"] = passish
      row["recent_passish"].push(passish)
      row["observations"] = row["observations"] + 1
      if status == "passed"
        row["pass_count"] = row["pass_count"] + 1
      elseif status == "failed"
        row["fail_count"] = row["fail_count"] + 1
        row["failure_count"] = row["failure_count"] + 1
      elseif status == "error"
        row["error_count"] = row["error_count"] + 1
        row["failure_count"] = row["failure_count"] + 1
      elseif status == "skipped"
        row["skipped_count"] = row["skipped_count"] + 1
      row["total_duration"] = row["total_duration"] + item["duration"]
      if item["duration"] > row["max_duration"]
        row["max_duration"] = item["duration"]
      source_id = text(item["source_id"])
      if source_id == ""
        source_id = text(item["run_id"])
      if source_id == ""
        source_id = text(item["timestamp"])
      if source_id != "" and row["source_ids"][source_id] == nil
        row["source_ids"][source_id] = "true"
        row["run_count"] = row["run_count"] + 1
      observed_at = text(item["observed_at"])
      if observed_at == ""
        observed_at = text(item["timestamp"])
      if observed_at != ""
        if (
          row["first_observed_at"] == "" or observed_at < row["first_observed_at"]
        )
          row["first_observed_at"] = observed_at
        if (
          row["last_observed_at"] == "" or observed_at > row["last_observed_at"]
        )
          row["last_observed_at"] = observed_at
      row["last_status"] = status
      i = i + 1

  build_rows: rows, filter_field, row_class, link_context ->
    data_rows = []
    for row in rows
      if filter_field == "" or row[filter_field] > 0
        data_rows.push(
          row_class(
            row,
            link_context["source_base_url"],
            link_context["source_root"],
            link_context["source_cache"],
            link_context["source_line_cache"]
          )
        )
    data_rows

  combined_items: junit_patterns, history_patterns ->
    out = []
    past_items = history_items(history_patterns)
    current_items = junit_items(junit_patterns)
    for item in past_items
      out.push(item)
    for item in current_items
      out.push(item)
    out

  enrich_items: items, opts ->
    for item in items
      item["repo"] = text(opts["repo"])
      item["workflow"] = text(opts["workflow"])
      item["run_id"] = text(opts["run_id"])
      item["run_attempt"] = text(opts["run_attempt"])
      item["job"] = text(opts["job"])
      item["sha"] = text(opts["sha"])
      item["branch"] = text(opts["branch"])
      item["event"] = text(opts["event"])
      source_id = text(item["source_id"])
      if item["run_id"] != ""
        item["source_id"] = item["run_id"]
          + "-"
          + item["run_attempt"]
          + "-"
          + source_id
    items

  failure_items: items ->
    out = []
    for item in items
      status = text(item["status"])
      if status == "failed" or status == "error"
        out.push(item)
    out

  history_items: patterns ->
    if patterns.len() == 0
      return []
    history.items_from_jsonl(patterns)

  items_for_branch: items, branch ->
    if branch == "*"
      return items
    out = []
    for item in items
      if text(item["branch"]) == branch
        out.push(item)
    out

  junit_items: patterns -> junit_items_from_files(junit.files(patterns))

  junit_items_from_files: files ->
    items = []
    for source in junit_sources_from_files(files)
      for item in source["items"]
        item["source_id"] = source["key"]
        item["observed_at"] = text(item["timestamp"])
        items.push(item)
    items

  junit_rows: patterns -> rows_from_items(junit_items(patterns))

  junit_sources: patterns -> junit_sources_from_files(junit.files(patterns))

  junit_sources_from_files: files ->
    sources = []
    for path_name in files
      items = junit.parse_file(path_name)
      key = path_name
      if items.len() > 0 and items[0]["timestamp"] != ""
        key = items[0]["timestamp"] + " " + path_name
      source = { path: path_name, key: key, items: items }
      sources.push(source)
    top_sources(sources)

  link_context: source_base_url, source_root, source_cache, source_line_cache ->
    context =
      source_base_url: source_base_url
      source_root: source_root
      source_cache: source_cache
      source_line_cache: source_line_cache
    context

  recent_all_passed: statuses, limit ->
    if statuses.len() < limit
      return false
    i = statuses.len() - limit
    while i < statuses.len()
      if statuses[i] != "true"
        return false
      i = i + 1
    true

  render: opts ->
    history_patterns = opts["history"]
    if history_patterns == nil
      history_patterns = []
    junit_patterns = opts["junit"]
    if junit_patterns == nil
      junit_patterns = []
    source_base_url = opts["source_base_url"]
    if source_base_url == nil
      source_base_url = ""
    source_root = opts["source_root"]
    if source_root == nil
      source_root = "."
    analysis_branch = opts["analysis_branch"]
    if analysis_branch == nil or analysis_branch == ""
      analysis_branch = "*"
    past_items = items_for_branch(
      history_items(history_patterns),
      analysis_branch
    )
    junit_files = junit.files(junit_patterns)
    current_items = enrich_items(junit_items_from_files(junit_files), opts)
    analysis_items = []
    for item in past_items
      analysis_items.push(item)
    for item in items_for_branch(current_items, analysis_branch)
      analysis_items.push(item)
    rows = rows_from_items(analysis_items)
    current_rows = rows_from_items(failure_items(current_items))
    history_rows = rows_from_items(failure_items(past_items))
    notices = []
    if junit_patterns.len() > 0 and junit_files.len() == 0
      if past_items.len() > 0
        notices.push(
          "No current JUnit XML files were found. Showing report data from history only."
        )
      else
        notices.push(
          "No JUnit XML files or history records were found. Check the JUnit artifact pattern and test report output path."
        )
    render_scoped_rows(
      rows,
      current_rows,
      history_rows,
      source_base_url,
      source_root,
      notices
    )

  render_and_export: opts ->
    history_patterns = opts["history"] ?? []
    junit_patterns = opts["junit"] ?? []
    source_base_url = opts["source_base_url"] ?? ""
    source_root = opts["source_root"] ?? "."
    analysis_branch = opts["analysis_branch"] ?? "*"
    if analysis_branch == ""
      analysis_branch = "*"
    analysis_by_test = {}
    current_failure_by_test = {}
    history_failure_by_test = {}
    history_count = 0
    history_files = history.files(history_patterns)
    history_file_index = 0
    while history_file_index < history_files.len()
      history_text = file.File.read(history_files[history_file_index])
      history_lines = history_text.split("\n")
      line_index = 0
      while line_index < history_lines.len()
        line = history_lines[line_index]
        if line != "" and not history.unsafe_json_chars?(line)
          item = history.record_from_jsonl(line)
          if analysis_branch == "*" or text(item["branch"]) == analysis_branch
            apply_items(analysis_by_test, [item])
            status = text(item["status"])
            if status == "failed" or status == "error"
              apply_items(history_failure_by_test, [item])
            history_count = history_count + 1
        line_index = line_index + 1
      history_file_index = history_file_index + 1
    junit_files = junit.files(junit_patterns)
    history_output = opts["history_output"] ?? ""
    if history_output != ""
      file.File.write(history_output, "")
    junit_file_index = 0
    while junit_file_index < junit_files.len()
      path_name = junit_files[junit_file_index]
      junit_items = junit.parse_file(path_name)
      export_lines = []
      item_index = 0
      while item_index < junit_items.len()
        item = history.record(opts, path_name, junit_items[item_index])
        if analysis_branch == "*" or text(item["branch"]) == analysis_branch
          apply_items(analysis_by_test, [item])
        status = text(item["status"])
        if status == "failed" or status == "error"
          apply_items(current_failure_by_test, [item])
        if history_output != ""
          export_lines.push(json.Json.dump(history.export_record(item)))
        item_index = item_index + 1
      if export_lines.len() > 0
        file.File.append(history_output, export_lines.join("\n") + "\n")
      junit_file_index = junit_file_index + 1
    notices = []
    if junit_patterns.len() > 0 and junit_files.len() == 0
      if history_count > 0
        notices.push(
          "No current JUnit XML files were found. Showing report data from history only."
        )
      else
        notices.push(
          "No JUnit XML files or history records were found. Check the JUnit artifact pattern and test report output path."
        )
    if history_output != ""
      println("wrote " + history_output)
    render_scoped_rows(
      rows_from_by_test(analysis_by_test),
      rows_from_by_test(current_failure_by_test),
      rows_from_by_test(history_failure_by_test),
      source_base_url,
      source_root,
      notices
    )

  render_file: opts ->
    html = render(opts)
    file.File.write(opts["output"], html)
    println("wrote " + opts["output"])

  render_page: data ->
    template
      .Template(template_path("report.html"))
      .render_file(data, { escape: "html" })

  render_rows: rows, source_base_url, source_root, notices ->
    source_cache = {}
    source_line_cache = {}
    data = self.template_data(
      rows,
      source_base_url,
      source_root,
      source_cache,
      source_line_cache,
      notices
    )
    render_page(data)

  render_scoped_rows: rows, current_rows, history_rows, source_base_url, source_root, notices ->
    source_cache = {}
    source_line_cache = {}
    scopes = { analysis: rows, current: current_rows, history: history_rows }
    data = self.template_data_scoped(
      scopes,
      source_base_url,
      source_root,
      source_cache,
      source_line_cache,
      notices
    )
    render_page(data)

  render_with_current: opts, current_items ->
    history_patterns = opts["history"] ?? []
    junit_patterns = opts["junit"] ?? []
    source_base_url = opts["source_base_url"] ?? ""
    source_root = opts["source_root"] ?? "."
    analysis_branch = opts["analysis_branch"] ?? "*"
    if analysis_branch == ""
      analysis_branch = "*"
    past_items = items_for_branch(
      history_items(history_patterns),
      analysis_branch
    )
    analysis_items = []
    for item in past_items
      analysis_items.push(item)
    for item in items_for_branch(current_items, analysis_branch)
      analysis_items.push(item)
    rows = rows_from_items(analysis_items)
    current_rows = rows_from_items(failure_items(current_items))
    history_rows = rows_from_items(failure_items(past_items))
    notices = []
    if junit_patterns.len() > 0 and junit.files(junit_patterns).len() == 0
      if past_items.len() > 0
        notices.push(
          "No current JUnit XML files were found. Showing report data from history only."
        )
      else
        notices.push(
          "No JUnit XML files or history records were found. Check the JUnit artifact pattern and test report output path."
        )
    render_scoped_rows(
      rows,
      current_rows,
      history_rows,
      source_base_url,
      source_root,
      notices
    )

  rows_from_by_test: by_test ->
    rows = []
    keys = by_test.keys()
    i = 0
    while i < keys.len()
      key = keys[i]
      row = by_test[key]
      row["avg_duration"] = row["total_duration"] / row["observations"]
      row["flake_score"] = same_sha_flake_score(row)
      row["healed_score"] = 0
      if row["flake_score"] > 0 and recent_all_passed(row["recent_passish"], 10)
        row["healed_score"] = row["flake_score"]
        row["flake_score"] = 0
      row["recent_passish"] = []
      row["sha_stats"] = {}
      rows.push(row)
      i = i + 1
    rows

  rows_from_items: items ->
    by_test = {}
    apply_items(by_test, items)
    rows_from_by_test(by_test)

  same_sha_flake_score: row ->
    score = 0
    for sha in row["sha_stats"].keys()
      sha_stat = row["sha_stats"][sha]
      if sha_stat["pass_count"] > 0 and sha_stat["failure_count"] > 0
        candidate = 50
          + sha_stat["transition_count"] * 10
          + sha_stat["failure_count"] * 5
        if candidate > score
          score = candidate
    score

  section: kind, title, rows, empty_message ->
    out =
      kind: kind
      title: title
      rows: rows
      empty_message: empty_message
      has_rows: rows.len() > 0
      flaky: kind == "flaky"
      healed: kind == "healed"
      failing: kind == "failing" or kind == "most_failing"
      slow: kind == "slow"
    out

  slow_count: rows ->
    count = 0
    for row in rows
      if row["max_duration"] > 0.0
        count = count + 1
    count

  template_data: rows, source_base_url, source_root, source_cache, source_line_cache, notices ->
    scopes = { analysis: rows, current: rows, history: rows }
    template_data_scoped(
      scopes,
      source_base_url,
      source_root,
      source_cache,
      source_line_cache,
      notices
    )

  template_data_scoped: scopes, source_base_url, source_root, source_cache, source_line_cache, notices ->
    source_cache = {}
    source_line_cache = {}
    rows = scopes["analysis"]
    current_rows = scopes["current"]
    history_rows = scopes["history"]
    total = 0
    observations = 0
    failures = 0
    source_ids = {}
    for row in rows
      total = total + 1
      observations = observations + row["observations"]
      failures = failures + row["fail_count"] + row["error_count"]
      for source_id in row["source_ids"].keys()
        source_ids[source_id] = "true"
    slow_tests = slow_count(rows)
    links = link_context(
      source_base_url,
      source_root,
      source_cache,
      source_line_cache
    )
    data =
      metrics: [
        {
          value: text(total),
          label: "tests"
        },
        {
          value: text(observations),
          label: "observations"
        },
        {
          value: text(source_ids.keys().len()),
          label: "test runs"
        },
        {
          value: text(failures),
          label: "failures/errors"
        },
        {
          value: text(slow_tests),
          label: "slow tests"
        }
      ]
      notices: notices
      sections: [
        section(
          "flaky",
          "Flaky Tests",
          build_rows(
            top_rows(rows, "flake_score", 20),
            "flake_score",
            Flaky,
            links
          ),
          "No flaky tests detected in these JUnit files."
        ),
        section(
          "healed",
          "Healed Candidates",
          build_rows(
            top_rows(rows, "healed_score", 20),
            "healed_score",
            Healed,
            links
          ),
          "No healed candidates detected. A test must have past pass/fail variation and 10 most recent passing observations."
        ),
        section(
          "failing",
          "Failing Tests",
          build_rows(
            top_rows(current_rows, "failure_count", 20),
            "failure_count",
            Failing,
            links
          ),
          "No failing tests found in the current JUnit files."
        ),
        section(
          "most_failing",
          "Most Failed Tests",
          build_rows(
            top_rows(history_rows, "failure_count", 20),
            "failure_count",
            Failing,
            links
          ),
          "No historical failures found in the selected history."
        ),
        section(
          "slow",
          "Slow Tests",
          build_rows(
            top_rows(rows, "max_duration", 20),
            "",
            Slow,
            links
          ),
          "No tests found in these JUnit files."
        )
      ]
    data

  template_path: name -> "src/flakewatch/templates/" + name

  text: value -> "{value}"

  top_rows: rows, field, limit ->
    out = []
    used = {}
    while out.len() < limit and out.len() < rows.len()
      best = nil
      best_index = -1
      i = 0
      while i < rows.len()
        key = text(i)
        if used[key] == nil
          if best == nil or rows[i][field] > best[field]
            best = rows[i]
            best_index = i
        i = i + 1
      if best == nil
        return out
      used[text(best_index)] = "true"
      out.push(best)
    out

  top_sources: sources -> sources.sort_by(source -> source["key"])
