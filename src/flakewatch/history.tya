import dir
import file
import json
import path

class History
  junit: nil

  initialize: ->
    self.junit = JUnit()

  collect_jsonl: root, out ->
    if root == ""
      root = "."
    if not file.File.exists?(root)
      return nil
    for name in dir.Dir.list(root)
      full = path.Path().join([root, name])
      if name.ends_with(".jsonl")
        out.push(full)
      elseif not name.contains(".")
        collect_jsonl(full, out)

  export_file: opts -> export_items(opts["output"], items_from_junit(opts))

  export_items: output, items ->
    file.File.write(output, "")
    lines = []
    i = 0
    while i < items.len()
      item = items[i]
      lines.push(export_line(item))
      if lines.len() >= 100
        file.File.append(output, lines.join("\n") + "\n")
        lines = []
      i = i + 1
    if lines.len() > 0
      file.File.append(output, lines.join("\n") + "\n")
    println("wrote " + output)

  export_line: item ->
    json_value = json.Json(nil)
    ["{{\"repo\":", json_value.escape_string(text(item["repo"])), ",\"workflow\":", json_value.escape_string(text(item["workflow"])), ",\"run_id\":", json_value.escape_string(text(item["run_id"])), ",\"run_attempt\":", json_value.escape_string(text(item["run_attempt"])), ",\"job\":", json_value.escape_string(text(item["job"])), ",\"sha\":", json_value.escape_string(text(item["sha"])), ",\"branch\":", json_value.escape_string(text(item["branch"])), ",\"event\":", json_value.escape_string(text(item["event"])), ",\"junit_path\":", json_value.escape_string(text(item["junit_path"])), ",\"suite\":", json_value.escape_string(text(item["suite"])), ",\"timestamp\":", json_value.escape_string(text(item["timestamp"])), ",\"observed_at\":", json_value.escape_string(text(item["observed_at"])), ",\"source_id\":", json_value.escape_string(text(item["source_id"])), ",\"classname\":", json_value.escape_string(text(item["classname"])), ",\"name\":", json_value.escape_string(text(item["name"])), ",\"file\":", json_value.escape_string(text(item["file"])), ",\"line\":", json_value.escape_string(text(item["line"])), ",\"duration\":", text(item["duration"]), ",\"status\":", json_value.escape_string(text(item["status"])), ",\"message\":", json_value.escape_string(text(item["message"])), "}}"].join(
      ""
    )

  export_record: item ->
    out =
      repo: item["repo"]
      workflow: item["workflow"]
      run_id: item["run_id"]
      run_attempt: item["run_attempt"]
      job: item["job"]
      sha: item["sha"]
      branch: item["branch"]
      event: item["event"]
      junit_path: item["junit_path"]
      suite: item["suite"]
      timestamp: item["timestamp"]
      observed_at: item["observed_at"]
      source_id: item["source_id"]
      classname: item["classname"]
      name: item["name"]
      file: item["file"]
      line: item["line"]
      duration: item["duration"]
      status: item["status"]
      message: item["message"]
    out

  files: patterns ->
    out = []
    for pattern in patterns
      if pattern.contains("**/*.jsonl")
        base = pattern.split("**/*.jsonl")[0]
        if base.ends_with("/")
          base = base.slice(0, base.byte_len() - 1)
        collect_jsonl(base, out)
      elseif file.File.exists?(pattern)
        out.push(pattern)
    out.sort()

  hex_digit?: char -> "0123456789abcdefABCDEF".contains(char)

  items_from_jsonl: patterns ->
    out = []
    for path_name in files(patterns)
      text = file.File.read(path_name)
      for line in text.split("\n")
        if line != ""
          if not unsafe_json_chars?(line)
            out.push(record_from_jsonl(line))
    out

  items_from_junit: opts ->
    out = []
    for path_name in junit.files(opts["junit"])
      for item in junit.parse_file(path_name)
        record = record(opts, path_name, item)
        out.push(record)
    out

  json_number: line, name ->
    marker = "\"" + name + "\":"
    if not line.contains(marker)
      return 0.0
    value = line.split(marker)[1].split(",")[0]
    value.to_f()

  json_string: line, name ->
    marker = "\"" + name + "\":\""
    if not line.contains(marker)
      return ""
    value = line.split(marker)[1].split("\"")[0]
    unescape_json_string(value)

  numeric_apostrophe_entity?: line, i ->
    if i + 4 >= line.byte_len()
      return false
    line[i] == "&"
      and line[i + 2] == "3"
      and line[i + 3] == "9"
      and line[i + 4] == ";"

  record: opts, junit_path, item ->
    item["repo"] = opts["repo"]
    item["workflow"] = opts["workflow"]
    item["run_id"] = opts["run_id"]
    item["run_attempt"] = opts["run_attempt"]
    item["job"] = opts["job"]
    item["sha"] = opts["sha"]
    item["branch"] = opts["branch"]
    item["event"] = opts["event"]
    item["junit_path"] = junit_path
    item["observed_at"] = item["timestamp"]
    item["source_id"] = opts["run_id"]
      + "-"
      + opts["run_attempt"]
      + "-"
      + junit_path
    item

  record_from_jsonl: line ->
    out =
      repo: json_string(line, "repo")
      workflow: json_string(line, "workflow")
      run_id: json_string(line, "run_id")
      run_attempt: json_string(line, "run_attempt")
      job: json_string(line, "job")
      sha: json_string(line, "sha")
      branch: json_string(line, "branch")
      event: json_string(line, "event")
      junit_path: json_string(line, "junit_path")
      suite: json_string(line, "suite")
      timestamp: json_string(line, "timestamp")
      observed_at: json_string(line, "observed_at")
      source_id: json_string(line, "source_id")
      classname: json_string(line, "classname")
      name: json_string(line, "name")
      file: json_string(line, "file")
      line: json_string(line, "line")
      duration: json_number(line, "duration")
      status: json_string(line, "status")
      message: json_string(line, "message")
    out

  safe_json_escape_at?: line, i ->
    if i + 5 >= line.byte_len()
      return false
    line[i] == "\\"
      and line[i + 1] == "u"
      and hex_digit?(line[i + 2])
      and hex_digit?(line[i + 3])
      and hex_digit?(line[i + 4])
      and hex_digit?(line[i + 5])

  text: value -> "{value}"

  unescape_json_string: text ->
    text
      .replace("\\\"", "\"")
      .replace("\\\\", "\\")
      .replace("\\/", "/")
      .replace("\\n", "\n")
      .replace("\\r", "\r")
      .replace("\\t", "\t")

  unsafe_json_chars?: line ->
    if line.contains("&")
      return true
    if line.byte_len() != line.len()
      return true
    i = 0
    while i < line.byte_len()
      if line[i] == "\\"
        if not safe_json_escape_at?(line, i)
          return true
        i = i + 6
      else
        if numeric_apostrophe_entity?(line, i)
          return true
        i = i + 1
    false
