import bytes
import flakewatch/*

embed "flakewatch/templates/server_index.html" as server_index_bytes
embed "flakewatch/templates/server_dashboard.html" as server_dashboard_bytes

index_html = bytes.Bytes(server_index_bytes).to_string()
dashboard_html = bytes.Bytes(server_dashboard_bytes).to_string()
flakewatch.Application.run_and_exit(args(), index_html, dashboard_html)
